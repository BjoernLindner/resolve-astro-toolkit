// =====================================================================
//  AstroStretch.dctl  -  v0.1.0  (version of the toolkit release it ships in)
//  Non-linear astro stretching for DaVinci Resolve Studio 18+
//
//  Adds the two stretch functions that are standard in astrophotography
//  and that Resolve does not ship with:
//
//    Arcsinh   y = asinh(s*x) / asinh(s)
//              Lifts faint signal hard and compresses the highlights
//              gently. Preserves channel ratios far better than a gamma
//              curve -> stars keep their colour instead of blowing out
//              to white. The classic first stretch.
//
//    MTF       y = ((m-1)*x) / ((2m-1)*x - m)
//              Midtone Transfer Function (the PixInsight histogram
//              transformation). More precise to control, but tends to
//              bloat stars. Good for the second, fine stretch.
//
//  IMPORTANT - colour space:
//
//  EXPECTS:  LINEAR, scene-referred data. On log data (DaVinci
//            Intermediate, S-Log, N-Log) the maths is simply wrong.
//            Either decode the RAW to linear, or put a CST in front
//            with tone mapping set to None.
//
//  EMITS:    DISPLAY-REFERRED data. Arcsinh and MTF are the transfer
//            function - that is what stretching means in astro. The
//            output is not linear light any more.
//
//            So do NOT close the node chain with CST Linear -> Adobe
//            RGB: that applies a second transfer function on top and
//            lifts the image twice. Convert the gamut on the way IN
//            instead, where the data is still linear and a matrix
//            conversion is colorimetrically correct.
//
//            See docs/workflow.md, "Where the colour space transforms
//            belong".
//
//  INSTALLATION:
//  1. Project Settings -> Color Management -> "Open LUT Folder"
//  2. Drop this file in there (a subfolder "Astro" is fine)
//  3. Click "Update Lists" in the LUT browser or Color Management
//  4. Apply: OpenFX panel -> drag "DCTL" onto a node,
//     pick "AstroStretch" in the Inspector.
//     (Right-clicking the node -> LUT does NOT work here, because this
//      DCTL has sliders - that path needs the DCTL OFX node.)
//  5. "Update Lists" makes a newly added DCTL appear. It does NOT
//     reliably reload one that is already applied to a node - restart
//     Resolve to test an edit to a DCTL that is in use.
//
//  USAGE - recommended order:
//  1. Black Point: raise slowly until the sky background goes dark -
//     but NOT until it clips. Aim for a background around 8-15 %,
//     never 0. The "Clip Warning" display helps.
//  2. Stretch: raise until the Milky Way becomes visible.
//     Two gentle nodes in series beat one aggressive one.
//  3. Preserve Color: leave at 1.0. Turned down to 0 it stretches per
//     channel - brighter, but star colours wash out.
//  4. Highlight Protection: only touch this if star cores blow out.
// =====================================================================

DEFINE_UI_PARAMS(mode,        Mode,                  DCTLUI_COMBO_BOX,     0, {M_ASINH, M_MTF}, {Arcsinh, MTF Midtone})
DEFINE_UI_PARAMS(stretch,     Arcsinh Stretch,       DCTLUI_SLIDER_FLOAT,  25.0f,  1.0f, 1000.0f, 0.5f)
DEFINE_UI_PARAMS(midtone,     MTF Midtone,           DCTLUI_SLIDER_FLOAT,   0.25f, 0.005f, 0.5f,  0.001f)
DEFINE_UI_PARAMS(blackpoint,  Black Point,           DCTLUI_SLIDER_FLOAT,   0.0f,  0.0f,  0.25f,  0.0002f)
DEFINE_UI_PARAMS(shadowlift,  Shadow Lift,           DCTLUI_SLIDER_FLOAT,   0.0f,  0.0f,  0.15f,  0.001f)
DEFINE_UI_PARAMS(preserve,    Preserve Color,        DCTLUI_SLIDER_FLOAT,   1.0f,  0.0f,  1.0f,   0.01f)
DEFINE_UI_PARAMS(hiprotect,   Highlight Protection,  DCTLUI_SLIDER_FLOAT,   0.0f,  0.0f,  1.0f,   0.01f)
DEFINE_UI_PARAMS(clipwarn,    Clip Warning,          DCTLUI_CHECK_BOX,      0)
DEFINE_UI_PARAMS(clampout,    Clamp Output,          DCTLUI_CHECK_BOX,      1)
DEFINE_UI_PARAMS(bypass,      Bypass,                DCTLUI_CHECK_BOX,      0)


// ---------------------------------------------------------------------
//  asinh(v) = log(v + sqrt(v*v + 1)), for v >= 0.
//  Written out because the DCTL runtime does not expose an inverse
//  hyperbolic sine - only _sinhf/_coshf/_tanhf are available.
//
//  PRECISION, so this does not get measured and filed again:
//  in float64 this identity is good to about 6e-10, and that figure
//  was published for v0.1.0. A DCTL runs in float32, where it is not.
//  For small v, v*v falls below the float32 epsilon of 1.19e-7, so
//  sqrt(v*v + 1) returns exactly 1, the sum becomes 1 + v, and
//  log(1 + v) loses most of its digits to cancellation. Measured
//  against a float64 reference over the range this function is
//  actually called with:
//
//      Arcsinh Stretch 25    max relative error 1.35e-3 at v = 1.2e-5
//      Arcsinh Stretch 400   max relative error 3.3e-4
//      above v = 1           1.4e-7, i.e. float32 epsilon
//
//  This is deliberately not corrected. The error is largest exactly
//  where the signal is smallest - at v = 1.2e-5 with stretch 25 the
//  output is around 3.2e-6, so 0.135 % of it is an absolute error of
//  about 4e-9, far below what any display, export or print carries.
//  The fix would be a series expansion for small v, which buys nothing
//  measurable and puts a branch in a per-pixel function.
//
//  Reproduce with examples/prototype_astro_dctl.py. See issue #32.
// ---------------------------------------------------------------------
__DEVICE__ float astro_asinh(float v)
{
    return _logf(v + _sqrtf(v * v + 1.0f));
}

// ---------------------------------------------------------------------
//  Arcsinh stretch, expressed as a multiplier.
//  Returns k with  y = k * x.  For x -> 0 the limit is s/asinh(s).
// ---------------------------------------------------------------------
__DEVICE__ float asinh_factor(float x, float s)
{
    float d = astro_asinh(s);
    if (d < 1e-8f) return 1.0f;
    if (x < 1e-7f) return s / d;
    return astro_asinh(s * x) / (x * d);
}

// ---------------------------------------------------------------------
//  Midtone Transfer Function (PixInsight), as a multiplier.
//  m = 0.5 is the identity, smaller values brighten.
// ---------------------------------------------------------------------
__DEVICE__ float mtf_factor(float x, float m)
{
    float mm = _clampf(m, 0.0005f, 0.9995f);
    if (_fabs(mm - 0.5f) < 1e-6f) return 1.0f;
    if (x < 1e-7f) return (mm - 1.0f) / (-mm);
    float num = (mm - 1.0f) * x;
    float den = (2.0f * mm - 1.0f) * x - mm;
    if (_fabs(den) < 1e-8f) return 1.0f;
    return (num / den) / x;
}

__DEVICE__ float stretch_factor(float x, int md, float s, float m)
{
    return (md == 0) ? asinh_factor(x, s) : mtf_factor(x, m);
}


__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float r = p_R;
    float g = p_G;
    float b = p_B;

    if (bypass) return make_float3(r, g, b);

    // ---- 1. Subtract the black point and rescale -----------------------
    float bp  = _clampf(blackpoint, 0.0f, 0.995f);
    float inv = 1.0f / (1.0f - bp);

    float r0 = _fmaxf((r - bp) * inv, 0.0f);
    float g0 = _fmaxf((g - bp) * inv, 0.0f);
    float b0 = _fmaxf((b - bp) * inv, 0.0f);

    // Remember whether the black point pushed this pixel all the way
    // to zero -> that is real loss of information.
    //
    // A pixel that arrived black carried nothing for the black point to
    // destroy, so it is not a clip. Without this test the letterbox or
    // pillarbox padding around the frame lights up red at every setting,
    // including a black point of zero, and the warning becomes noise.
    int was_black = (r <= 0.0f && g <= 0.0f && b <= 0.0f) ? 1 : 0;
    int clipped   = (!was_black && r0 <= 0.0f && g0 <= 0.0f && b0 <= 0.0f) ? 1 : 0;

    // ---- 2. Stretch ----------------------------------------------------
    // Rec.709 luminance. Slightly off in DWG, but perfectly good enough
    // for weighting a brightness multiplier.
    float lum = 0.2126f * r0 + 0.7152f * g0 + 0.0722f * b0;

    // Variant A: multiplier derived from luminance -> channel ratios,
    //            and with them star colours, are preserved.
    float kl = stretch_factor(lum, mode, stretch, midtone);

    // Variant B: each channel on its own -> brighter, but desaturated.
    float kr = stretch_factor(r0, mode, stretch, midtone);
    float kg = stretch_factor(g0, mode, stretch, midtone);
    float kb = stretch_factor(b0, mode, stretch, midtone);

    float w = _clampf(preserve, 0.0f, 1.0f);
    float mr = kl * w + kr * (1.0f - w);
    float mg = kl * w + kg * (1.0f - w);
    float mb = kl * w + kb * (1.0f - w);

    float r1 = r0 * mr;
    float g1 = g0 * mg;
    float b1 = b0 * mb;

    // ---- 3. Highlight protection ---------------------------------------
    // Fades the stretch back towards the original value in the topmost
    // tones. Keeps star cores small and coloured instead of bloating
    // them into white discs.
    float hp = _clampf(hiprotect, 0.0f, 1.0f);
    if (hp > 0.0f)
    {
        float thr = 1.0f - 0.9f * hp;           // onset point
        float t   = _clampf((lum - thr) / _fmaxf(1.0f - thr, 1e-4f), 0.0f, 1.0f);
        float s   = t * t * (3.0f - 2.0f * t);  // smoothstep
        s *= hp;
        r1 = r1 * (1.0f - s) + r0 * s;
        g1 = g1 * (1.0f - s) + g0 * s;
        b1 = b1 * (1.0f - s) + b0 * s;
    }

    // ---- 4. Shadow lift ------------------------------------------------
    // Raises the whole image slightly so the sky background stays above
    // zero. Guards against crushed shadows in print and against banding
    // in dark areas.
    float sl = _clampf(shadowlift, 0.0f, 0.5f);
    if (sl > 0.0f)
    {
        float k = 1.0f - sl;
        r1 = r1 * k + sl;
        g1 = g1 * k + sl;
        b1 = b1 * k + sl;
    }

    // ---- 5. Clip warning -----------------------------------------------
    // Paints pixels red whose information the black point destroyed.
    // Turn on while dialling in, turn off before rendering.
    if (clipwarn && clipped)
        return make_float3(1.0f, 0.0f, 0.0f);

    if (clampout)
    {
        r1 = _clampf(r1, 0.0f, 1.0f);
        g1 = _clampf(g1, 0.0f, 1.0f);
        b1 = _clampf(b1, 0.0f, 1.0f);
    }

    return make_float3(r1, g1, b1);
}
