// =====================================================================
//  AstroSCNR.dctl  ·  v1.0
//  Subtractive Chromatic Noise Reduction for DaVinci Resolve Studio
//
//  Removes the green cast that practically every stretched astro image
//  develops. Cause: the Bayer matrix has twice as many green photosites
//  as red or blue ones, and every stretch amplifies that along with the
//  signal.
//
//  The method comes from PixInsight and has a physical basis: there are
//  practically no green objects in the night sky. Wherever green sits
//  well above the mean of red and blue, it is noise or a calibration
//  error - and it can go.
//
//  Methods (neutral protection):
//    Average Neutral    G' = min(G, (R+B)/2)       standard, strong
//    Maximum Neutral    G' = min(G, max(R,B))      gentler
//    Additive Mask      G' = G*(1-a) + min(G,x)*a  soft blend
//
//  USAGE:
//  AFTER the stretch, BEFORE final saturation. On linear data SCNR does
//  little, because the green excess is still small there.
//
//  Set Amount to 1.0 first, judge the effect, then dial back until the
//  sky is neutral without the landscape in the foreground losing its
//  green. If the foreground suffers: restrict this node to the sky with
//  a Power Window.
//
//  CAREFUL with real airglow: green night-sky glow is a real phenomenon.
//  If you want it in the image, keep Amount well below 1.0 or skip this
//  node entirely.
//
//  INSTALLATION:
//  Project Settings -> Color Management -> "Open LUT Folder",
//  drop the file in there, click "Update Lists".
//  Apply via the OpenFX panel -> DCTL (not via right-click -> LUT,
//  because this DCTL has sliders).
// =====================================================================

DEFINE_UI_PARAMS(method,   Method,             DCTLUI_COMBO_BOX,    0, {AVG_NEUTRAL, MAX_NEUTRAL, ADD_MASK}, {Average Neutral, Maximum Neutral, Additive Mask})
DEFINE_UI_PARAMS(amount,   Amount,             DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 1.0f,  0.01f)
DEFINE_UI_PARAMS(preserve, Preserve Luminance, DCTLUI_CHECK_BOX,    0)
DEFINE_UI_PARAMS(showmask, Show Mask,          DCTLUI_CHECK_BOX,    0)
DEFINE_UI_PARAMS(bypass,   Bypass,             DCTLUI_CHECK_BOX,    0)


__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, float p_R, float p_G, float p_B)
{
    float r = p_R;
    float g = p_G;
    float b = p_B;

    if (bypass) return make_float3(r, g, b);

    float a = _clampf(amount, 0.0f, 1.0f);

    // Reference value that green must not exceed
    float limit;
    if (method == 0)        limit = 0.5f * (r + b);      // Average Neutral
    else if (method == 1)   limit = _fmaxf(r, b);        // Maximum Neutral
    else                    limit = 0.5f * (r + b);      // Additive Mask

    float g_new = _fminf(g, limit);

    // Blend. "Additive Mask" additionally weights the blend by how
    // large the green excess actually is.
    float w = a;
    if (method == 2)
    {
        float excess = g - limit;
        float soft   = _clampf(excess * 4.0f, 0.0f, 1.0f);
        w = a * soft;
    }

    float g_out = g * (1.0f - w) + g_new * w;

    // How much green was removed - used for the mask display and for
    // the luminance compensation
    float removed = g - g_out;

    if (showmask)
    {
        float m = _clampf(removed * 8.0f, 0.0f, 1.0f);
        return make_float3(m, m, m);
    }

    // Optional: redistribute the removed brightness onto red and blue
    // so the image does not get darker overall. Tends towards magenta -
    // only use it when the brightness loss is actually a problem.
    if (preserve && removed > 0.0f)
    {
        float share = removed * 0.5f;
        r = r + share;
        b = b + share;
    }

    return make_float3(r, g_out, b);
}
