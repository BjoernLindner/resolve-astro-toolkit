// =====================================================================
//  AstroSCNR.dctl  ·  v1.0
//  Subtractive Chromatic Noise Reduction fuer DaVinci Resolve Studio
//
//  Entfernt den Gruenstich, den praktisch jedes gestretchte Astrofoto
//  bekommt. Ursache: die Bayer-Matrix hat doppelt so viele Gruen- wie
//  Rot-/Blaupixel, und jeder Stretch verstaerkt das mit.
//
//  Das Verfahren stammt aus PixInsight und ist physikalisch begruendet:
//  am Nachthimmel gibt es praktisch keine gruenen Objekte. Wo Gruen
//  deutlich ueber dem Mittel von Rot und Blau liegt, ist es Rauschen
//  oder Kalibrierungsfehler - und darf weg.
//
//  Verfahren (Neutral Protection):
//    Average Neutral    G' = min(G, (R+B)/2)      Standard, kraeftig
//    Maximum Neutral    G' = min(G, max(R,B))     schonender
//    Additive Mask      G' = G*(1-a) + min(G,x)*a  weich ueberblendet
//
//  ANWENDUNG:
//  NACH dem Stretch, VOR der finalen Saettigung. Auf linearen Daten
//  bringt SCNR wenig, weil der Gruenueberschuss dort noch klein ist.
//
//  Erst Staerke auf 1.0 stellen, den Effekt beurteilen, dann
//  zurueckdrehen bis der Himmel neutral ist ohne dass die Landschaft
//  im Vordergrund ihr Gruen verliert. Falls der Vordergrund leidet:
//  diesen Node mit einem Power Window auf den Himmel begrenzen.
//
//  ACHTUNG bei echtem Airglow: gruenes Nachthimmelsleuchten ist ein
//  reales Phaenomen. Wenn du es im Bild haben willst, Staerke deutlich
//  unter 1.0 halten oder ganz weglassen.
//
//  INSTALLATION:
//  Project Settings -> Color Management -> "Open LUT Folder",
//  Datei dort ablegen, "Update Lists" klicken.
//  Anwenden ueber OpenFX-Panel -> DCTL (nicht ueber Rechtsklick->LUT,
//  weil dieses DCTL Regler hat).
// =====================================================================

DEFINE_UI_PARAMS(method,   Verfahren,      DCTLUI_COMBO_BOX,    0, {AVG_NEUTRAL, MAX_NEUTRAL, ADD_MASK}, {Average Neutral, Maximum Neutral, Additive Mask})
DEFINE_UI_PARAMS(amount,   Staerke,        DCTLUI_SLIDER_FLOAT, 1.0f, 0.0f, 1.0f,  0.01f)
DEFINE_UI_PARAMS(preserve, Luminanz halten,DCTLUI_CHECK_BOX,    0)
DEFINE_UI_PARAMS(showmask, Maske zeigen,   DCTLUI_CHECK_BOX,    0)
DEFINE_UI_PARAMS(bypass,   Bypass,         DCTLUI_CHECK_BOX,    0)


__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y,
                            float p_R, float p_G, float p_B)
{
    float r = p_R;
    float g = p_G;
    float b = p_B;

    if (bypass) return make_float3(r, g, b);

    float a = _clampf(amount, 0.0f, 1.0f);

    // Referenzwert, den Gruen nicht ueberschreiten darf
    float limit;
    if (method == 0)        limit = 0.5f * (r + b);      // Average Neutral
    else if (method == 1)   limit = _fmaxf(r, b);        // Maximum Neutral
    else                    limit = 0.5f * (r + b);      // Additive Mask

    float g_new = _fminf(g, limit);

    // Ueberblenden. Bei "Additive Mask" wird zusaetzlich weicher
    // gewichtet, je nachdem wie stark der Gruenueberschuss ist.
    float w = a;
    if (method == 2)
    {
        float excess = g - limit;
        float soft   = _clampf(excess * 4.0f, 0.0f, 1.0f);
        w = a * soft;
    }

    float g_out = g * (1.0f - w) + g_new * w;

    // Wie viel Gruen wurde abgezogen - fuer Maskenanzeige und
    // Luminanzausgleich
    float removed = g - g_out;

    if (showmask)
    {
        float m = _clampf(removed * 8.0f, 0.0f, 1.0f);
        return make_float3(m, m, m);
    }

    // Optional: die entfernte Helligkeit auf Rot und Blau verteilen,
    // damit das Bild nicht insgesamt dunkler wird. Faerbt tendenziell
    // magenta - nur benutzen wenn der Helligkeitsverlust stoert.
    if (preserve && removed > 0.0f)
    {
        float half = removed * 0.5f;
        r = r + half;
        b = b + half;
    }

    return make_float3(r, g_out, b);
}
